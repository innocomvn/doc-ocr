# Server Configuration
PORT=3000

# OCR Service Configuration
# Set to 'true' to use ONNX Runtime (requires ONNX models)
# Set to 'false' to use Python wrapper (default)
USE_ONNX=false

# Upload Configuration
UPLOAD_MAX_SIZE=10485760

# Model Paths (for ONNX service)
DETECTION_MODEL_PATH=./models/detection.onnx
RECOGNITION_MODEL_PATH=./models/recognition.onnx
